{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/analysis-result.schema.json",
  "title": "JapaneseVerseAnalysisResult",
  "type": "object",
  "required": [
    "version",
    "source",
    "input",
    "normalized",
    "tokens",
    "grammar",
    "translationZh",
    "summaryZh",
    "meta"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source": {
      "type": "string",
      "description": "URL where selection is made."
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "normalized": {
      "type": "string",
      "minLength": 1
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "grammar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grammarHit"
      }
    },
    "translationZh": {
      "type": "string",
      "description": "Simple zh-CN paraphrase generated by local rules."
    },
    "summaryZh": {
      "type": "string",
      "description": "One-line understanding note."
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "required": [
        "surface",
        "baseForm",
        "reading",
        "pos",
        "glossZh"
      ],
      "properties": {
        "surface": {
          "type": "string"
        },
        "baseForm": {
          "type": "string"
        },
        "reading": {
          "type": "string"
        },
        "pos": {
          "type": "string"
        },
        "glossZh": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "grammarHit": {
      "type": "object",
      "required": [
        "type",
        "pattern",
        "explanationZh"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "particle",
            "verb-form",
            "phrase-pattern",
            "other"
          ]
        },
        "pattern": {
          "type": "string"
        },
        "explanationZh": {
          "type": "string"
        },
        "example": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": [
        "elapsedMs",
        "tokenizer",
        "fallbackUsed",
        "timestamp"
      ],
      "properties": {
        "elapsedMs": {
          "type": "number"
        },
        "tokenizer": {
          "type": "string"
        },
        "fallbackUsed": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
